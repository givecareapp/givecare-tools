{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/givecareapp/givecare-tools/packages/benefit-evidence/schema/benefit-evidence.schema.json",
  "title": "BenefitEvidence v0.1",
  "description": "Source-backed claims a publisher makes about one benefit program. Uncertainty is a published state, never a missing field.",
  "type": "object",
  "required": ["profile", "subject", "claims"],
  "properties": {
    "profile": { "const": "BenefitEvidence/v0.1" },
    "subject": {
      "type": "object",
      "required": ["program_id"],
      "properties": {
        "program_id": { "type": "string", "minLength": 1, "description": "The stable identifier the publisher's directory uses for this program." },
        "common_benefits_program_id": { "type": "string", "minLength": 1 }
      }
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rulespec"],
        "properties": { "rulespec": { "type": "string", "format": "uri" } }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" },
    "source": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "excerpt": { "type": "string" },
        "captured_at": { "$ref": "#/$defs/date" }
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "kind", "value", "state", "checked_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1, "description": "What the claim is about, for example access or availability." },
        "value": { "description": "The claimed value, or null for an explicit absence of value." },
        "state": { "enum": ["supported", "unknown", "conflicting", "expired"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "checked_at": { "$ref": "#/$defs/date" },
        "review_by": { "$ref": "#/$defs/date" },
        "review_policy": { "type": "string", "minLength": 1 },
        "rulespec": { "type": "string", "format": "uri" }
      },
      "if": { "properties": { "state": { "const": "supported" } } },
      "then": { "required": ["evidence"], "properties": { "evidence": { "minItems": 1 } } }
    }
  }
}
