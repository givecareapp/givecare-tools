{
  "name": "@givecare/tools",
  "version": "4.1.0",
  "description": "GiveCare Tools: compatibility entry for @givecare/assessment (GC-SDOH instruments and the GiveCare Score)",
  "license": "MIT",
  "author": "Ali Madad <ali@scty.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/givecareapp/givecare-tools"
  },
  "homepage": "https://github.com/givecareapp/givecare-tools#readme",
  "bugs": {
    "url": "https://github.com/givecareapp/givecare-tools/issues"
  },
  "keywords": [
    "sdoh",
    "caregiver",
    "social-determinants",
    "assessment",
    "scoring",
    "givecare"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./assessments": {
      "import": "./dist/src/assessments.js",
      "types": "./dist/src/assessments.d.ts"
    },
    "./scoring": {
      "import": "./dist/src/scoring.js",
      "types": "./dist/src/scoring.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc && npm run build --workspaces --if-present",
    "prepare": "tsc",
    "check": "scripts/check.sh",
    "ci": "npm run check",
    "typecheck": "scripts/check.sh typecheck",
    "typecheck:tsc": "GC_TYPECHECKER=tsc scripts/check.sh typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "project:instruments": "tsx scripts/project-instruments.ts",
    "prepublishOnly": "npm run ci && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "^4.23.8",
    "typescript": "7.1.0-beta",
    "vitest": "^4.1.7"
  }
}
