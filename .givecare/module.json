{
  "schema_version": "givecare.module/v1",
  "repository": "gc-tools",
  "modules": [
    {
      "id": "tools.assessments",
      "authority": {
        "kind": "typescript",
        "ref": "src/assessments/instruments.ts"
      },
      "truth": [
        {
          "kind": "method",
          "ref": "src/assessments/instruments.ts"
        },
        {
          "kind": "specification",
          "ref": "GC-SDOH.md"
        },
        {
          "kind": "projection",
          "ref": "data/instruments-export.json"
        },
        {
          "kind": "projection-kernel",
          "ref": "evidence-driver.json#corpus.project"
        }
      ],
      "verifiers": [
        "npm run ci",
        "hound driver check --driver evidence-driver.json"
      ],
      "capabilities": [
        {
          "name": "methods.assessment.define",
          "effect": "read",
          "gate": "none",
          "adapter": {
            "kind": "library",
            "ref": "src/assessments/instruments.ts#getInstrument"
          },
          "accepts": [
            "@givecare/tools.InstrumentName"
          ],
          "emits": [
            "@givecare/tools.AssessmentInstrument"
          ]
        },
        {
          "name": "methods.assessment.score",
          "effect": "read",
          "gate": "none",
          "adapter": {
            "kind": "library",
            "ref": "src/assessments/instruments.ts#scoreInstrument"
          },
          "accepts": [
            "@givecare/tools.InstrumentName",
            "string",
            "Record<string,number>"
          ],
          "emits": [
            "@givecare/tools.AssessmentScore"
          ]
        },
        {
          "name": "methods.assessment.project",
          "effect": "write",
          "gate": "none",
          "adapter": {
            "kind": "evidence-operation",
            "ref": "evidence-driver.json#corpus.project"
          },
          "accepts": [
            "gc-tools.hound.project.input.v1"
          ],
          "emits": [
            "gc-tools.hound.project-plan.v1",
            "gc-tools.hound.project-result.v1",
            "givecare.artifact-ref/v1",
            "@givecare/tools.InstrumentExport"
          ]
        }
      ]
    },
    {
      "id": "tools.scoring",
      "authority": {
        "kind": "typescript",
        "ref": "src/scoring/givecareScore.ts"
      },
      "truth": [
        {
          "kind": "method",
          "ref": "src/scoring/givecareScore.ts"
        }
      ],
      "verifiers": [
        "npm run ci"
      ],
      "capabilities": [
        {
          "name": "methods.givecare-score.compute",
          "effect": "read",
          "gate": "none",
          "adapter": {
            "kind": "library",
            "ref": "src/scoring/givecareScore.ts#computeGiveCareScoreFromInstruments"
          },
          "accepts": [
            "@givecare/tools.InstrumentResult"
          ],
          "emits": [
            "@givecare/tools.GiveCareScoreResult"
          ]
        },
        {
          "name": "methods.ema-reading.compute",
          "effect": "read",
          "gate": "none",
          "adapter": {
            "kind": "library",
            "ref": "src/scoring/givecareScore.ts#computeEmaReading"
          },
          "accepts": [
            "Record<string,number>"
          ],
          "emits": [
            "@givecare/tools.EmaReadingResult"
          ]
        },
        {
          "name": "methods.score-trend.compute",
          "effect": "read",
          "gate": "none",
          "adapter": {
            "kind": "library",
            "ref": "src/scoring/givecareScore.ts#computeScoreTrend"
          },
          "accepts": [
            "number",
            "Array<{score:number,computedAt:number}>"
          ],
          "emits": [
            "@givecare/tools.ScoreTrend"
          ]
        },
        {
          "name": "methods.score-spike.detect",
          "effect": "read",
          "gate": "none",
          "adapter": {
            "kind": "library",
            "ref": "src/scoring/givecareScore.ts#detectSpike"
          },
          "accepts": [
            "number",
            "Array<{score:number,computedAt:number}>"
          ],
          "emits": [
            "@givecare/tools.Spike"
          ]
        }
      ]
    },
    {
      "id": "tools.sms",
      "authority": {
        "kind": "typescript",
        "ref": "src/sms/"
      },
      "truth": [
        {
          "kind": "method",
          "ref": "src/sms/regulatory.ts"
        },
        {
          "kind": "method",
          "ref": "src/sms/quietHours.ts"
        }
      ],
      "verifiers": [
        "npm run ci"
      ],
      "capabilities": [
        {
          "name": "methods.sms-regulatory.parse",
          "effect": "read",
          "gate": "none",
          "adapter": {
            "kind": "library",
            "ref": "src/sms/regulatory.ts#parseRegulatoryCommand"
          },
          "accepts": [
            "string"
          ],
          "emits": [
            "@givecare/tools.RegulatoryCommand"
          ]
        },
        {
          "name": "methods.quiet-hours.resolve",
          "effect": "read",
          "gate": "none",
          "adapter": {
            "kind": "library",
            "ref": "src/sms/quietHours.ts#nextAllowedSendAt"
          },
          "accepts": [
            "{now:number,timezone:string,enabled:boolean,startHour?:number,endHour?:number}"
          ],
          "emits": [
            "number"
          ]
        }
      ]
    },
    {
      "id": "tools.geo",
      "authority": {
        "kind": "typescript",
        "ref": "src/geo/"
      },
      "truth": [
        {
          "kind": "method",
          "ref": "src/geo/timezone.ts"
        },
        {
          "kind": "method",
          "ref": "src/geo/zipToState.ts"
        }
      ],
      "verifiers": [
        "npm run ci"
      ],
      "capabilities": [
        {
          "name": "methods.timezone.infer",
          "effect": "read",
          "gate": "none",
          "adapter": {
            "kind": "library",
            "ref": "src/geo/timezone.ts#inferTimezoneFromAreaCode"
          },
          "accepts": [
            "string"
          ],
          "emits": [
            "string"
          ]
        },
        {
          "name": "methods.state.resolve",
          "effect": "read",
          "gate": "none",
          "adapter": {
            "kind": "library",
            "ref": "src/geo/zipToState.ts#zipToState"
          },
          "accepts": [
            "string"
          ],
          "emits": [
            "string"
          ]
        }
      ]
    }
  ]
}
